        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "3. Pick up with audio only",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "During a call, you have access to the following features:"
          }
        ]
      },
      {
