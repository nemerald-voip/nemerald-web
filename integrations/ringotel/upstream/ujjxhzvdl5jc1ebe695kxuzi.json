      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "1. Mute / unmute microphone",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "2. Put the call on hold",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "3. Turn the speaker on / off, switch to Bluetooth",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "4. Open the Numpad to send DTMF",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "5. Turn call recording on / off",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "6. Open a contact's profile",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "7. Transfer a call",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "8. Make a parallel call",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "9. Turn video on / off",
            "italic": true
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "10. Open a chat with the contact",
            "italic": true
          }
        ]
      }
